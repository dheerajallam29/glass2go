{"a":"Economic Concepts","d":2,"q":"What is scarcity?","r":["Limited resources compared with unlimited wants","It forces choices."],"w":[["Having more resources than anyone needs","That is abundance."],["A rise in prices","That is inflation."],["A fall in demand","That is a demand change."]]}
{"a":"Economic Concepts","d":2,"q":"What are the factors of production?","r":["Land, labor, capital and entrepreneurship","They are the inputs to make goods."],"w":[["Cash, checks, cards and coins","Those are payment forms."],["Buyers, sellers, banks and brokers","Those are market participants."],["Sales, profit, rent and tax","Those are results or costs."]]}
{"a":"Economic Concepts","d":3,"q":"A factory building and its machines are examples of which factor?","r":["Capital","Tools and facilities used to produce."],"w":[["Land","That is natural resources."],["Labor","That is workers."],["Entrepreneurship","That is risk-taking."]]}
{"a":"Economic Concepts","d":2,"q":"What is opportunity cost?","r":["The value of the next best alternative given up","Every choice has one."],"w":[["The price on the tag","That is the price."],["The total of all costs","That is total cost."],["The cost of advertising","That is a marketing cost."]]}
{"a":"Economic Concepts","d":2,"q":"What is supply?","r":["The quantity of a good that sellers offer at various prices","It generally rises with price."],"w":[["The quantity buyers want at various prices","That is demand."],["The money in the economy","That is the money supply."],["The profit of a seller","That is income."]]}
{"a":"Economic Concepts","d":3,"q":"The price of concert tickets rises and more tickets are offered for sale. Which law is shown?","r":["The law of supply","Higher prices bring more quantity supplied."],"w":[["The law of demand","That concerns buyers."],["The law of diminishing returns","That concerns input use."],["The law of scarcity","That concerns limited resources."]]}
{"a":"Economic Concepts","d":2,"q":"What is equilibrium price?","r":["The price at which quantity supplied equals quantity demanded","The market clears."],"w":[["The highest price allowed by law","That is a ceiling."],["The lowest possible price","That is a floor idea."],["The price set by one seller alone","That is not equilibrium."]]}
{"a":"Economic Concepts","d":2,"q":"What is a substitute good?","r":["A product that can replace another","Tea and coffee are examples."],"w":[["A product used together with another","That is a complement."],["A product that is too costly","That is not it."],["A product that is illegal","That is not it."]]}
{"a":"Economic Concepts","d":3,"q":"The price of coffee rises sharply. What happens to demand for tea, a substitute?","r":["It increases","Buyers switch to tea."],"w":[["It decreases","Substitutes gain demand."],["It disappears","It continues."],["It stays the same","It shifts."]]}
{"a":"Economic Concepts","d":2,"q":"What is a complement good?","r":["A product used together with another","Printers and ink are examples."],"w":[["A product that replaces another","That is a substitute."],["A product that is free","That is not it."],["A product that is imported","That is not it."]]}
{"a":"Economic Systems","d":2,"q":"What is a market economy?","r":["An economy where individuals and businesses make most decisions through markets","Prices guide choices."],"w":[["An economy where the government decides everything","That is command."],["An economy based only on tradition","That is traditional."],["An economy with no trade","That is isolation."]]}
{"a":"Economic Systems","d":2,"q":"What is a traditional economy?","r":["An economy where customs and habits guide production","Roles pass through generations."],"w":[["An economy guided by prices alone","That is a market economy."],["An economy planned by a central authority","That is command."],["An economy using only digital money","That is not it."]]}
{"a":"Economic Systems","d":3,"q":"A village where farmers grow what their parents grew and trade by custom has which system?","r":["Traditional economy","Custom guides choices."],"w":[["Command economy","No central planner."],["Market economy","Not price-driven."],["Mixed economy","It follows custom."]]}
{"a":"Economic Systems","d":2,"q":"What is private property?","r":["Resources owned by individuals or firms rather than the government","It is a pillar of free enterprise."],"w":[["Resources owned by the state only","That is public."],["Resources no one owns","That is common."],["Resources rented from the government","That is leasing."]]}
{"a":"Economic Systems","d":2,"q":"What is the profit motive?","r":["The desire to earn money that drives businesses to produce","It encourages efficiency."],"w":[["A rule against earning money","That is the opposite."],["A tax on profits","That is a tax."],["A law about prices","That is not it."]]}
{"a":"Business Nature","d":2,"q":"What is a business?","r":["An organization that provides goods or services to earn a profit","It meets customer needs."],"w":[["A group that gives away goods","That is a charity."],["A government office","That is public."],["A hobby with no customers","That is not a business."]]}
{"a":"Business Nature","d":2,"q":"What is a nonprofit organization?","r":["An organization that serves a cause and reinvests surplus into its mission","Owners do not take profits."],"w":[["An organization that tries to lose money","That is not the goal."],["An organization owned by shareholders","That describes for-profit firms."],["An organization with no employees","It may have them."]]}
{"a":"Business Nature","d":3,"q":"A group sells baked goods and uses all the proceeds for a local shelter. This is most like:","r":["A nonprofit activity","Surplus serves a cause."],"w":[["A for-profit corporation","Owners do not keep profits."],["A monopoly","It has no market control."],["A franchise","It has no franchisor."]]}
{"a":"Business Nature","d":2,"q":"What are the three main types of business activities?","r":["Production, marketing and finance","Firms combine them."],"w":[["Reading, writing and math","Those are school subjects."],["Buying, selling and hiding","Hiding is not an activity."],["Planning, resting and playing","Those are not business types."]]}
{"a":"Business Nature","d":2,"q":"What is a service business?","r":["A business that provides work or expertise instead of physical goods","Salons and repair shops are examples."],"w":[["A business that makes physical goods","That is manufacturing."],["A business that sells used items only","That is resale."],["A business owned by the government","That is public."]]}
{"a":"Business Nature","d":3,"q":"Which is a service business?","r":["A dental clinic","It provides care."],"w":[["A car factory","It makes goods."],["A bakery that sells bread only","It sells goods."],["A farm growing wheat","It produces goods."]]}
{"a":"Business Nature","d":2,"q":"What is a merchandising business?","r":["A business that buys products and resells them to customers","Retail stores are examples."],"w":[["A business that makes products from raw materials","That is manufacturing."],["A business that sells advice","That is a service."],["A business that lends money","That is finance."]]}
{"a":"Business Nature","d":2,"q":"What is entrepreneurship?","r":["Starting and running a business while taking on risk","Entrepreneurs seek opportunities."],"w":[["Working only for a fixed paycheck","That is employment."],["Avoiding all risk","Risk is involved."],["Studying economics","That is study."]]}
{"a":"Business Nature","d":3,"q":"Which trait is most important for an entrepreneur?","r":["Willingness to take calculated risks","Business ventures are uncertain."],"w":[["Avoiding every decision","That blocks progress."],["Waiting for others to act","Initiative is needed."],["Ignoring customers","Customers drive success."]]}
{"a":"Cost and Profit","d":2,"q":"What is revenue?","r":["The money a business earns from selling goods or services","It comes before expenses."],"w":[["The money left after all costs","That is profit."],["The money owed to suppliers","That is a liability."],["The money invested by owners","That is capital."]]}
{"a":"Cost and Profit","d":2,"q":"How is profit calculated?","r":["Revenue minus expenses","A positive result is profit."],"w":[["Revenue plus expenses","That overstates."],["Expenses minus revenue","That reverses it."],["Revenue times expenses","That is not it."]]}
{"a":"Cost and Profit","d":3,"q":"A shop earns $12,000 and has $9,500 in expenses. What is its profit?","r":["$2,500","$12,000 minus $9,500."],"w":[["$21,500","That adds them."],["$9,500","That is expenses."],["$12,000","That is revenue."]]}
{"a":"Cost and Profit","d":2,"q":"What is break-even?","r":["The point where revenue equals total costs","There is no profit or loss."],"w":[["The point of maximum profit","That is not it."],["The point of greatest loss","That is not it."],["The point where sales stop","That is not it."]]}
{"a":"Cost and Profit","d":3,"q":"Fixed costs are $1,000 and each unit sells for $10 with $6 variable cost. What is the break-even quantity?","r":["250 units","$1,000 divided by $4 per unit."],"w":[["100 units","That divides by the price."],["1,000 units","That is the fixed cost."],["167 units","That divides by $6."]]}
{"a":"Cost and Profit","d":2,"q":"What is gross profit?","r":["Sales minus the cost of goods sold","It comes before operating expenses."],"w":[["Sales minus all expenses","That is net profit."],["Sales plus costs","That is not it."],["The cost of goods","That is COGS."]]}
{"a":"Cost and Profit","d":2,"q":"What is net profit?","r":["Revenue minus all expenses including taxes","It is the bottom line."],"w":[["Revenue minus cost of goods sold only","That is gross profit."],["Revenue only","That is sales."],["Expenses only","That is cost."]]}
{"a":"Cost and Profit","d":3,"q":"Sales $50,000, COGS $30,000, operating expenses $12,000. What is the net profit before taxes?","r":["$8,000","$50,000 - $30,000 - $12,000."],"w":[["$20,000","That is gross profit."],["$18,000","That ignores one cost."],["$92,000","That adds the numbers."]]}
{"a":"Cost and Profit","d":2,"q":"What is a markup?","r":["The amount added to cost to set a selling price","It covers expenses and profit."],"w":[["A discount given to customers","That is a markdown."],["A tax on goods","That is a tax."],["A fee paid to suppliers","That is a cost."]]}
{"a":"Cost and Profit","d":3,"q":"An item costs $20 and the store adds a 50% markup. What is the selling price?","r":["$30","$20 plus $10."],"w":[["$10","That is the markup."],["$70","That is not the result."],["$40","That doubles the cost."]]}
{"a":"Owning a Business","d":2,"q":"What is a sole proprietorship?","r":["A business owned and run by one person","The owner has unlimited liability."],"w":[["A business owned by many shareholders","That is a corporation."],["A business owned by two or more partners","That is a partnership."],["A business owned by the government","That is public."]]}
{"a":"Owning a Business","d":2,"q":"What is a partnership?","r":["A business owned by two or more people who share profits and duties","Partners often share liability."],"w":[["A business owned by one person","That is a proprietorship."],["A business owned by shareholders with limited liability","That is a corporation."],["A business owned by the state","That is public."]]}
{"a":"Owning a Business","d":2,"q":"What is a corporation?","r":["A business that is a separate legal entity owned by shareholders","Owners have limited liability."],"w":[["A business owned by one person with no separate status","That is a proprietorship."],["A business run by two friends informally","That is a partnership."],["A group of charities","That is nonprofits."]]}
{"a":"Owning a Business","d":3,"q":"Which form protects an owner's personal assets from business debts?","r":["A corporation or LLC","They offer limited liability."],"w":[["A sole proprietorship","Liability is unlimited."],["A general partnership","Liability is shared and unlimited."],["A garage sale","It is not a form."]]}
{"a":"Owning a Business","d":2,"q":"What is a franchise?","r":["A right to use a company's brand and system in exchange for fees","McDonald's operates this way."],"w":[["A free gift from a company","Fees are charged."],["A government contract","That is public."],["A type of loan","That is financing."]]}
{"a":"Owning a Business","d":2,"q":"What is a business plan?","r":["A document describing a business's goals and how it will reach them","Lenders often ask for it."],"w":[["A bank statement","That is a record."],["A list of employees","That is a roster."],["A tax return","That is a filing."]]}
{"a":"Owning a Business","d":3,"q":"Which section of a business plan explains how the company will attract customers?","r":["Marketing plan","It covers promotion and sales."],"w":[["Financial statements","They show numbers."],["Company legal name","That is identity."],["Employee handbook","That is HR."]]}
{"a":"Owning a Business","d":2,"q":"What is start-up capital?","r":["Money needed to launch a business","It pays for equipment and early costs."],"w":[["Money earned after years of operation","That is revenue."],["Money owed to customers","That is a liability."],["Money paid in taxes","That is a tax."]]}
{"a":"Owning a Business","d":2,"q":"What is a license?","r":["Official permission to operate a business or activity","Governments issue them."],"w":[["A price list","That is a catalog."],["A customer review","That is feedback."],["A company slogan","That is advertising."]]}
{"a":"Owning a Business","d":2,"q":"What is a loan?","r":["Money borrowed that must be repaid, usually with interest","Banks lend to businesses."],"w":[["Money given with no repayment","That is a gift."],["Money earned from sales","That is revenue."],["Money owned by the business","That is equity."]]}
{"a":"Business Activities","d":2,"q":"What is marketing?","r":["Activities that identify and satisfy customer needs to profit","It includes product, price, place and promotion."],"w":[["Only selling at a low price","That is narrow."],["Only making products","That is production."],["Only hiring workers","That is HR."]]}
{"a":"Business Activities","d":2,"q":"What are the four Ps of marketing?","r":["Product, price, place and promotion","They form the marketing mix."],"w":[["People, plans, profits and policies","Those are not the Ps."],["Pencil, paper, pen and printer","Those are supplies."],["Pay, perks, positions and protection","Those are HR terms."]]}
{"a":"Business Activities","d":3,"q":"A company decides where and how customers can buy its product. Which P is this?","r":["Place","It covers distribution."],"w":[["Product","That is what is sold."],["Price","That is what is charged."],["Promotion","That is how it is advertised."]]}
{"a":"Business Activities","d":2,"q":"What is customer service?","r":["Assistance a business gives customers before, during and after a purchase","Good service builds loyalty."],"w":[["Ignoring complaints","That harms the business."],["Raising prices","That is pricing."],["Making products only","That is production."]]}
{"a":"Business Activities","d":2,"q":"What is production?","r":["Creating goods or services to meet demand","It turns inputs into outputs."],"w":[["Selling goods to customers","That is sales."],["Recording transactions","That is accounting."],["Hiring workers","That is HR."]]}
{"a":"Business Activities","d":2,"q":"What does human resources do?","r":["Hires, trains and supports employees","It manages people."],"w":[["Prepares financial statements","That is accounting."],["Designs advertisements","That is marketing."],["Ships products","That is distribution."]]}
{"a":"Business Activities","d":3,"q":"Which department would handle writing job descriptions and interviewing candidates?","r":["Human resources","It manages hiring."],"w":[["Accounting","It handles money records."],["Production","It makes products."],["Shipping","It moves goods."]]}
{"a":"Business Activities","d":2,"q":"What is accounting?","r":["Recording and reporting a business's financial information","It supports decisions."],"w":[["Designing logos","That is graphic design."],["Delivering goods","That is distribution."],["Making sales calls","That is selling."]]}
{"a":"Careers","d":2,"q":"What is a career?","r":["A person's long-term path of work and growth","It may include several jobs."],"w":[["A single day of work","That is a shift."],["A school assignment","That is school work."],["A hobby done on weekends","That is leisure."]]}
{"a":"Careers","d":2,"q":"What is a transferable skill?","r":["A skill useful across many jobs, such as communication","Employers value them."],"w":[["A skill useful in only one job","That is specialized."],["A skill that cannot be learned","Skills can be learned."],["A skill used only at home","That is limited."]]}
{"a":"Careers","d":3,"q":"Which is a transferable skill?","r":["Teamwork","It helps in almost any job."],"w":[["Operating one specific machine","That is job specific."],["Memorizing one script","That is narrow."],["Knowing one store's layout","That is narrow."]]}
{"a":"Careers","d":2,"q":"What is networking?","r":["Building relationships that can help with career opportunities","Contacts can share leads."],"w":[["Connecting computers only","That is IT."],["Avoiding people","That is not networking."],["Buying equipment","That is not networking."]]}
{"a":"Careers","d":2,"q":"What belongs on a résumé?","r":["Contact information, education, experience and skills","It summarizes qualifications."],"w":[["Your favorite foods","That is irrelevant."],["Your passwords","That is unsafe."],["Your bank balance","That is private."]]}
{"a":"Careers","d":3,"q":"Which is the best way to end a job interview?","r":["Thank the interviewer and restate your interest","It leaves a good impression."],"w":[["Leave without a word","It is rude."],["Ask only about vacation","It signals the wrong focus."],["Criticize the company","It is unprofessional."]]}
{"a":"Careers","d":2,"q":"What is a cover letter?","r":["A letter introducing yourself and explaining why you fit a job","It accompanies the résumé."],"w":[["A bill for services","That is an invoice."],["A letter of complaint","That is not it."],["A tax document","That is not it."]]}
{"a":"Careers","d":2,"q":"What is a reference?","r":["A person who can vouch for your skills and character","Employers may contact them."],"w":[["A document about the job","That is a job description."],["A book you read","That is not it."],["A list of past pay","That is not it."]]}
{"a":"Careers","d":3,"q":"Before listing someone as a reference, you should:","r":["Ask for their permission","It is courteous and prepares them."],"w":[["Assume they will agree","That is presumptuous."],["Use a random name","That is dishonest."],["Avoid telling them","That surprises them."]]}
{"a":"Careers","d":2,"q":"What is professionalism?","r":["Behaving responsibly, respectfully and reliably at work","It includes punctuality."],"w":[["Arriving late often","That is unprofessional."],["Ignoring coworkers","That is unprofessional."],["Dressing carelessly in all cases","Context matters."]]}
{"a":"Careers","d":2,"q":"What is a job description?","r":["A document listing the duties and requirements of a position","It helps applicants decide."],"w":[["A list of employee salaries","That is payroll."],["A company's profit report","That is financial."],["A map of the office","That is facilities."]]}
{"a":"Careers","d":3,"q":"Where can you find the required skills for a job you want?","r":["The job posting or description","It lists expectations."],"w":[["A random advertisement","It may not match."],["A friend's guess","It may be wrong."],["The company's lunch menu","It is irrelevant."]]}
